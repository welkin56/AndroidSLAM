# Gradle 构建输出。
build/
.gradle/

# 换台机器、换个用户就错，属于机器状态不是源码。Android Studio 会自动重建。
local.properties

# Android Studio / IntelliJ 的索引和窗口布局，同样是机器状态
.idea/
*.iml
captures/

# NDK 中间产物（阶段五接 JNI 之后会生成）
.externalNativeBuild/
.cxx/

# 由 CMakeLists 里的 export_compile_commands 目标导出，是生成物不是源码
app/src/main/cpp/compile_commands.json

# 安卓版 Boost：它是**构建产物**不是源码 —— 绑死 NDK 版本和编译选项，150 MB，
# 而 13 个头文件里的 serialize() 只用到 libboost_serialization 这一个。
# 拿不到的：Boost 没有官方安卓发布物，跑 tools/setup-boost-android.sh 自己编。
app/src/main/cpp/thirdparty/boost-android/

# 系统垃圾
.DS_Store
