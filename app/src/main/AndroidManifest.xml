<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 12 (API 31) 起新增。想以超过 200Hz 采样传感器就必须声明它。
         SENSOR_DELAY_FASTEST 等价于 0 微秒（不限速），不声明会直接抛
         SecurityException 让 App 崩掉。
         这是 normal 级权限，安装时自动授予，不需要运行时申请。 -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".SlamApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.SlamCapture">

        <!-- 入口页。冷启动落在这儿，选完地图才进 MainActivity。
             它自己**不是** singleTop —— 没有理由拦重复启动，而且它只做记账。 -->
        <activity
            android:name=".EntryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SLAM 主界面。 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 录制页（采集端）。和 SLAM **互斥的两个模式**，各开各的相机 ——
             见 APP_DESIGN §6 / §7.1。它保留着自己的一套 IDLE/ARMED/RECORDING。 -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 标定页：不碰 SLAM，自己开一路相机。 -->
        <activity
            android:name=".CalibActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 标定板要能发到别的设备/打印店，走 FileProvider 给一张 PNG。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
