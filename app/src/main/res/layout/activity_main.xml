<?xml version="1.0" encoding="utf-8"?>
<!--
  SLAM 主界面。

  竖直分三段：状态（芯片 + 横幅）→ 画面 → 控制。状态芯片只放「一眼要看到」的四件事，
  位置、纹理数、地图统计、路径都收进抽屉底部的诊断面板。

  ⚠️ 小地图浮在预览上面（画中画），所以预览得包进 FrameLayout。
  `mapWrap` 自己不接管触摸，`MapView` 也不 ⟹ 点小窗空白处等于点预览。
  只有那两个缩放键消费自己的触摸 —— 所以它们是**真 Button**，不是画布上自绘的。
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 主内容。抽屉必须挂在 DrawerLayout 下面，所以这一层包着。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 状态区。查看器打开时整块隐藏，所以横幅放在这里面而不是外面。 -->
        <LinearLayout
            android:id="@+id/rowStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp">

                <!-- 四颗芯片横着放，窄屏可滑。 -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/chipTrack"
                            style="@style/TextAppearance.SlamCapture.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="● 未运行"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/chipPoints"
                            style="@style/TextAppearance.SlamCapture.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="轨迹 0 点"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipRecord"
                            style="@style/TextAppearance.SlamCapture.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="● 录制"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipMap"
                            style="@style/TextAppearance.SlamCapture.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip"
                            android:ellipsize="end"
                            android:maxWidth="150dp"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="新建地图"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btnMenu"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="菜单"
                    app:icon="@drawable/ic_menu"
                    app:iconSize="24dp"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>

        </LinearLayout>

        <!-- 画面 + 右上角的 2D 地图小窗。 -->
        <FrameLayout
            android:id="@+id/previewWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.example.slamcapture.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />

            <FrameLayout
                android:id="@+id/mapWrap"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp">

                <com.example.slamcapture.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="5dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMapZoomOut"
                        style="@style/Widget.SlamCapture.ZoomButton"
                        android:layout_width="34dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#66000000"
                        android:contentDescription="缩小"
                        app:icon="@drawable/ic_remove"
                        app:iconSize="16dp"
                        app:iconTint="#FFFFFFFF"
                        app:strokeColor="#66FFFFFF"
                        app:strokeWidth="1dp" />

                    <Button
                        android:id="@+id/btnMapZoomIn"
                        style="@style/Widget.SlamCapture.ZoomButton"
                        android:layout_width="34dp"
                        android:layout_height="32dp"
                        android:backgroundTint="#66000000"
                        android:contentDescription="放大"
                        app:icon="@drawable/ic_add"
                        app:iconSize="16dp"
                        app:iconTint="#FFFFFFFF"
                        app:strokeColor="#66FFFFFF"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 横幅浮在画面底部，不参与布局：跟踪状态反复变化时不会推动预览高度。
                 查看器打开时由 render() 显式收起（elevation 会打乱绘制顺序）。 -->
            <LinearLayout
                android:id="@+id/bannerWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_banner"
                android:clickable="false"
                android:elevation="6dp"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />
            </LinearLayout>

            <!-- 地图查看器：全屏的 2D 地图（默认藏）。
                 一张图一个坐标系 —— 一次只看一张，切图用顶部的地图列表。
                 地图上支持单指拖动、双指捏合；不做双击。 -->
            <FrameLayout
                android:id="@+id/viewerWrap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF101418"
                android:visibility="gone">

                <com.example.slamcapture.MapView
                    android:id="@+id/viewerMapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_viewer_bar"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvViewerMap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="地图"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnViewerClose"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="关闭"
                            app:icon="@drawable/ic_close"
                            app:iconSize="22dp"
                            app:iconTint="#FFFFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnViewerCurrent"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="当前"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnViewerRefresh"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="刷新"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnViewerFit"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="适应"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnViewerSlice"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="切片:高度"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnViewerZoomIn"
                        style="@style/Widget.SlamCapture.ZoomButton"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="6dp"
                        android:backgroundTint="#66000000"
                        android:contentDescription="放大"
                        app:icon="@drawable/ic_add"
                        app:iconSize="18dp"
                        app:iconTint="#FFFFFFFF"
                        app:strokeColor="#66FFFFFF"
                        app:strokeWidth="1dp" />

                    <Button
                        android:id="@+id/btnViewerZoomOut"
                        style="@style/Widget.SlamCapture.ZoomButton"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:backgroundTint="#66000000"
                        android:contentDescription="缩小"
                        app:icon="@drawable/ic_remove"
                        app:iconSize="18dp"
                        app:iconTint="#FFFFFFFF"
                        app:strokeColor="#66FFFFFF"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- 多点折线测距。绑死在「实时测距」开关上 —— 关着就 GONE。 -->
        <LinearLayout
            android:id="@+id/rowMeasure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAddPoint"
                style="@style/Widget.SlamCapture.MeasureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="加点" />

            <Button
                android:id="@+id/btnBreakChain"
                style="@style/Widget.SlamCapture.MeasureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="断开" />

            <Button
                android:id="@+id/btnUndoPoint"
                style="@style/Widget.SlamCapture.MeasureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="撤销" />

            <Button
                android:id="@+id/btnResetPoints"
                style="@style/Widget.SlamCapture.MeasureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置" />
        </LinearLayout>

        <!-- 主按钮放最下面，好按。 -->
        <LinearLayout
            android:id="@+id/rowBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnSlam"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="准备 SLAM"
                android:textSize="15sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 抽屉：从右边出来，条目多了可以滚。 -->
    <ScrollView
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/colorSurface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SlamCapture"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="实时定位与测距"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:text="显示"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- 录制落盘开关。开着的时候按「启动 SLAM」会自动开始录。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="录制落盘" />

            <!-- 实时测距（画面中心的十字 + 读数）。关掉时 C++ 那边连算都不算。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMeasure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="实时测距" />

            <!-- 小地图。关掉时 SLAM 线程连点云快照都不重建。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="小地图" />

            <TextView
                android:id="@+id/tvMapRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sbMapRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="0.05"
                android:valueFrom="0.2"
                android:valueTo="4.0"
                app:labelBehavior="gone" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="标记"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- 路径点：显示开关 + 加 + 管理。路径点锚在关键帧上。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swWaypoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="路径点" />

            <Button
                android:id="@+id/btnWpAdd"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="添加路径点" />

            <Button
                android:id="@+id/btnWpManage"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="管理路径点" />

            <!-- 实时轨迹：小地图上本趟走过的路线。关掉只剩点云和当前位置。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swTraj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="实时轨迹" />

            <!-- 历史轨迹：同一张图以前各趟的轨迹。 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="历史轨迹" />

            <Button
                android:id="@+id/btnHistoryManage"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="管理历史轨迹" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="地图"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- 地图查看器：全屏 2D 地图，atlas 里有几张图就能切几遍。 -->
            <Button
                android:id="@+id/btnMapViewer"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="地图查看" />

            <!-- 诊断面板：日常不展开。所有数字、路径、保存结果都在这里。 -->
            <LinearLayout
                android:id="@+id/drawerDiagHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="诊断信息"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:id="@+id/drawerDiagChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="展开诊断信息"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
