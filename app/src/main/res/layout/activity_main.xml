<?xml version="1.0" encoding="utf-8"?>
<!--
  SLAM 主界面。

  排版和录制页**故意不同**：这里是「状态 → 画面 → 按钮」，录制页是「画面 → 状态 → 按钮」。
  原因：这一页你盯着的是「现在能不能用」（词袋加载完没有、跟踪丢没丢），画面是辅助；
  录制页盯着的是画面（构图、对上焦没有）。

  ⚠️ 这一步是空壳：画面是黑的（相机接线是 M5），「重定位」恒灰。
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容。抽屉必须挂在 DrawerLayout 下面，所以这一层包着。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:text="SLAM：未启动" />

            <!-- 主题是 NoActionBar，所以没有系统 ActionBar 的汉堡键，自己放一个。
                 点它开右边的抽屉。 -->
            <Button
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="48dp"
                android:text="☰"
                android:textSize="18sp"
                android:textColor="#DE000000" />
        </LinearLayout>

        <!-- 画面。黑底既是 letterbox 的黑边，也是「没有画面时露出来的东西」。
             ⚠️ 现在没人喂它（M5 才接相机），所以它就是个黑框。 -->
        <com.example.slamcapture.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <!-- 多点折线测距。**绑死在「实时测距」开关上** —— 关着就 GONE。
             ⚠️ 预览是 weight=1 ⟹ 这一行出现/消失时预览高度变一次。那是拨开关那一下，不是每帧跳。 -->
        <LinearLayout
            android:id="@+id/rowMeasure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAddPoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:text="加点"
                android:textColor="@color/measure_button_text" />

            <Button
                android:id="@+id/btnBreakChain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:text="断开"
                android:textColor="@color/measure_button_text" />

            <Button
                android:id="@+id/btnUndoPoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:text="撤销"
                android:textColor="@color/measure_button_text" />

            <Button
                android:id="@+id/btnResetPoints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="重置"
                android:textColor="@color/measure_button_text" />
        </LinearLayout>

        <!-- 两个按钮放最下面，好按。「重定位」灰着是**有理由的灰** —— 还没有旧图（§2.2），
             不是"还没实现"。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnSlam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="启动 SLAM"
                android:textColor="#DE000000" />

            <Button
                android:id="@+id/btnReloc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:enabled="false"
                android:text="重定位"
                android:textColor="#DE000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 抽屉：从右边出来。
         ⚠️ 先只有一条占位 —— 空抽屉比一个灰按钮更让人困惑（点开了什么都没有）。 -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="菜单"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 录制落盘开关。**开着的时候按「启动 SLAM」会自动开始录** ——
             不用先启动再回来点一下（那中间有一段录不上）。
             录出来的 session 标了 with_slam，和「录制模式」录的分得开。 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="录制落盘"
            android:textColor="#DE000000" />

        <!-- 实时测距（画面中心的十字 + 读数）。关掉时 C++ 那边连算都不算。
             和「录制落盘」一样**记在 SharedPreferences 里**，下次进来还是这个状态。 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swMeasure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实时测距"
            android:textColor="#DE000000" />

        <!-- 还没做的，灰着。空抽屉比一个灰按钮更让人困惑，所以留一条。 -->
        <Button
            android:id="@+id/btnSaveMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="保存地图（M8）"
            android:textColor="#DE000000" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
