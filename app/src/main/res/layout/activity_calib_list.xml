<?xml version="1.0" encoding="utf-8"?>
<!--
  标定档位列表：管理各屈光度（距离）下的一整套内参。

  版式直接照入口页的节奏排：
    标题 → 副标题 → 主按钮 → 分区标题 + 控件 → 卡片列表
  主按钮放在标题下方而不是页底，是入口页的选择（「新建地图」就在这个位置）。
  排序芯片贴在分区标题右侧，不单独占一行 —— 它是列表的控件，不是页面的一层。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:text="标定档位"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface" />

    <!-- 机型 · 相机 · IMU。换设备后一眼能看出这张表是不是这台机器的。 -->
    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Button
        android:id="@+id/btnNewCalib"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:text="新建档位"
        android:textSize="15sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnPrimary" />

    <!-- 排在档位按钮下面、用 tonal 样式：它和「新建档位」是两件事 ——
         一个按屈光度存内参，一个和屈光度无关、全局只有一份。 -->
    <Button
        android:id="@+id/btnImuCalib"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:text="IMU 噪声标定"
        android:textSize="14sp"
        app:cornerRadius="16dp" />

    <!--
      分区标题 + 排序控件同一行。点已选中的那颗 = 翻转方向，点另一颗 = 换排序键。
      方向只标在选中的那颗上，两颗都带箭头会让人以为它们各自有方向。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="档位"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/chipSortDiopter"
            style="@style/TextAppearance.SlamCapture.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="屈光度"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chipSortTime"
            style="@style/TextAppearance.SlamCapture.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="最近时间"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 空状态只给文字：没有「标定」语义的图标可用，塞一个意思不对的不如不塞。 -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="还没有标定档位\n\n每一档对应一个对焦距离。标完之后，在这个距离附近的测量会用到它。"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <ListView
            android:id="@+id/calibList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:listSelector="@android:color/transparent"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
    </FrameLayout>

</LinearLayout>
