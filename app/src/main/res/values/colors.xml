    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#9CF1F4</color>
    <color name="md_on_primary_container">#002021</color>

    <color name="md_secondary">#4A6363</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#CCE7E7</color>
    <color name="md_on_secondary_container">#051F20</color>

    <color name="md_tertiary">#4B607C</color>
